<div class="confirm-dialog" data-confirm-dialog hidden>
  <div class="confirm-backdrop" data-confirm-cancel></div>
  <section class="confirm-card" role="dialog" aria-modal="true" aria-labelledby="confirm-dialog-title" tabindex="-1">
    <p class="eyebrow">CONFIRM TRANSACTION</p>
    <h2 id="confirm-dialog-title" data-confirm-heading>确认操作</h2>
    <p class="confirm-message" data-confirm-message>请确认是否继续。</p>
    <dl class="confirm-details" data-confirm-details hidden></dl>
    <p class="confirm-note" data-confirm-note hidden></p>
    <div class="confirm-actions">
      <button class="button button-ghost" type="button" data-confirm-cancel>取消</button>
      <button class="button button-primary" type="button" data-confirm-accept>确认操作</button>
    </div>
  </section>
</div>