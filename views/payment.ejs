<%- include('partials/head', { bodyClass: 'checkout-page' }) %>
<main class="checkout-shell">
  <header class="checkout-header">
    <a class="brand" href="/">
      <span class="brand-mark">E</span>
      <span><strong>Epay</strong><small>Secure Test Checkout</small></span>
    </a>
    <div class="checkout-header-actions">
      <span class="test-badge">SANDBOX</span>
      <% if (currentUser) { %><a class="text-link" href="/pay/<%= encodeURIComponent(order.tradeNo) %>/logout">退出当前账号</a><% } %>
    </div>
  </header>

  <section class="checkout-card">
    <div class="checkout-summary">
      <p class="eyebrow">支付订单</p>
      <h1><%= order.name %></h1>
      <div class="amount"><small><%= order.currency %></small><%= order.money %></div>
      <dl class="summary-list">
        <div><dt>商户</dt><dd><%= order.merchantName %></dd></div>
        <div><dt>订单号</dt><dd><code><%= order.outTradeNo %></code></dd></div>
        <div><dt>网关流水</dt><dd><code><%= order.tradeNo %></code></dd></div>
        <div><dt>支付方式</dt><dd><%= order.type %></dd></div>
      </dl>
      <div class="countdown-box <%= remainingSeconds <= 0 ? 'expired' : '' %>" data-expires="<%= order.expiresAt %>" data-order-status-url="/pay/<%= encodeURIComponent(order.tradeNo) %>/status" data-order-status="<%= order.status %>">
        <span>订单剩余时间</span>
        <strong data-countdown><%= Math.floor(remainingSeconds / 60) %>:<%= String(remainingSeconds % 60).padStart(2, '0') %></strong>
      </div>
    </div>

    <div class="checkout-payment">
      <div class="step-label"><span>1</span> 绑定的虚拟银行卡</div>
      <% if (card) { %>
        <div class="virtual-card <%= card.status !== 'active' ? 'virtual-card-muted' : '' %>">
          <div class="virtual-card-top">
            <span><%= card.brand %></span>
            <span><%= card.cardType %></span>
          </div>
          <div class="card-number">•••• •••• •••• <%= card.last4 %></div>
          <div class="virtual-card-bottom">
            <span>VALID THRU <strong><%= String(card.expiresMonth).padStart(2, '0') %>/<%= String(card.expiresYear).slice(-2) %></strong></span>
            <span class="card-network">EPAY</span>
          </div>
        </div>
        <div class="card-meta">
          <span class="pill <%= card.status === 'active' ? 'pill-success' : 'pill-danger' %>"><%= statusLabel(card.status) %></span>
          <span>余额 <%= card.currency %> <%= formatMinor(card.balanceMinor) %></span>
        </div>
      <% } else { %>
        <div class="empty-state compact">该订单未绑定虚拟卡，请联系商户重新创建订单。</div>
      <% } %>

      <% if (error) { %>
        <div class="alert alert-danger" role="alert"><%= error %></div>
      <% } %>

      <% if (order.status === 'PENDING') { %>
        <form method="post" action="/pay/<%= encodeURIComponent(order.tradeNo) %>/confirm" class="pay-form">
          <% if (require3ds) { %>
            <div class="step-label"><span>2</span> 3DS 安全验证</div>
            <label class="field">
              <span>3DS 密码</span>
              <input type="password" name="pin" inputmode="numeric" autocomplete="one-time-code" required placeholder="输入卡片设置的 3DS 密码" <%= order.canPay ? '' : 'disabled' %>>
            </label>
          <% } else { %>
            <div class="step-label"><span>2</span> 确认支付</div>
            <div class="alert alert-info">3DS 验证已关闭，无需输入 3DS 密码。</div>
          <% } %>
          <button class="button button-primary button-pay" type="submit" <%= order.canPay && card ? '' : 'disabled' %> data-pay-button data-currency="<%= order.currency %>" data-amount="<%= order.money %>">
            确认支付 <%= order.currency %> <%= order.money %>
          </button>
          <p class="secure-note">此页面仅允许使用订单绑定的虚拟卡。不会产生真实资金交易。</p>
        </form>
        <form method="post" action="/pay/<%= encodeURIComponent(order.tradeNo) %>/change-payment" class="stack-form payment-method-back" data-payment-submit>
          <button class="button button-ghost button-block" type="submit">返回并重新选择支付方式</button>
          <p class="form-hint">支付完成前，可返回重新选择账户余额或其他虚拟卡。</p>
        </form>
      <% } else { %>
        <div class="payment-state payment-state-<%= order.status.toLowerCase() %>">
          <strong><%= statusLabel(order.status) %></strong>
          <p>该订单已结束，无法继续支付。</p>
          <% if (order.returnUrl) { %><a class="text-link" href="<%= order.returnUrl %>">返回商户网站</a><% } %>
        </div>
      <% } %>
    </div>
  </section>

  <p class="checkout-footer">Epay Test Gateway · 仅用于测试，不处理真实银行卡信息</p>
</main>
<script src="/js/payment.js?v=<%= assetVersion %>" defer></script>
</body>
</html>
