<%- include('../partials/head', { bodyClass: 'login-page' }) %>
<main class="login-shell">
  <section class="login-panel">
    <div class="login-brand"><span class="brand-mark">E</span><span><strong>Epay</strong><small>Test Gateway</small></span></div>
    <p class="eyebrow">PASSWORD RECOVERY</p>
    <h1>找回密码</h1>
    <% if (!emailConfigured) { %>
      <div class="alert alert-warning">管理员尚未配置验证码发件邮箱，请联系管理员修改密码。</div>
      <a class="button button-ghost button-block" href="/admin/login">返回登录</a>
    <% } else { %>
      <p class="login-subtitle">验证码只会发送到账号已绑定的邮箱。未绑定邮箱或邮件发送失败时，请联系管理员修改密码。</p>
      <% if (error) { %><div class="alert alert-danger"><%= error %></div><% } %>
      <% if (message) { %><div class="alert alert-info"><%= message %></div><% } %>
      <form method="post" action="/admin/forgot-password" class="stack-form" data-password-reset-form>
        <label class="field"><span>用户名</span><input name="username" value="<%= form.username || '' %>" autocomplete="username" required></label>
        <label class="field"><span>账号绑定邮箱</span><input type="email" name="email" value="<%= form.email || '' %>" maxlength="255" autocomplete="email" required></label>
        <div class="form-row">
          <label class="field"><span>邮箱验证码</span><input name="email_code" inputmode="numeric" maxlength="6" pattern="[0-9]{6}" autocomplete="one-time-code" required></label>
          <label class="field"><span>&nbsp;</span><button class="button button-ghost button-block" type="button" data-send-reset-code>发送验证码</button></label>
        </div>
        <p class="form-hint" data-reset-code-status></p>
        <label class="field"><span>新密码</span><input type="password" name="new_password" autocomplete="new-password" maxlength="128" required></label>
        <label class="field"><span>确认新密码</span><input type="password" name="confirm_password" autocomplete="new-password" maxlength="128" required></label>
        <button class="button button-primary button-block" type="submit">验证并重置密码</button>
      </form>
    <% } %>
    <p class="login-hint"><a class="text-link" href="/admin/login">返回登录</a></p>
  </section>
  <aside class="login-aside">
    <div class="login-aside-copy"><span class="status-dot">ACCOUNT SECURITY</span><h2>通过绑定邮箱安全找回账户。</h2><ul><li>验证码仅发送到账号已绑定邮箱</li><li>验证码一次性使用并有有效期</li><li>密码重置后旧登录会话全部失效</li><li>无法收信时请联系管理员处理</li></ul></div>
  </aside>
</main>
<script src="/js/password-reset.js?v=<%= assetVersion %>" defer></script>
</body>
</html>
