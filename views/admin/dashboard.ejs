<%- include('../partials/head', { bodyClass: 'admin-page' }) %>
<%- include('../partials/admin-start') %>
<section class="stat-grid">
  <article class="stat-card stat-accent">
    <div class="stat-icon">¥</div>
    <div><span>虚拟卡总余额</span><strong>¥ <%= formatMinor(stats.balance) %></strong><small><%= stats.cards %> 张卡片</small></div>
  </article>
  <article class="stat-card">
    <div class="stat-icon">▣</div>
    <div><span>可用虚拟卡</span><strong><%= stats.activeCards %></strong><small>共 <%= stats.cards %> 张</small></div>
  </article>
  <article class="stat-card">
    <div class="stat-icon">↗</div>
    <div><span>成功交易额</span><strong>¥ <%= formatMinor(stats.paidVolume) %></strong><small><%= stats.paid %> 笔已支付</small></div>
  </article>
  <article class="stat-card">
    <div class="stat-icon">…</div>
    <div><span>待处理订单</span><strong><%= stats.pending %></strong><small><%= stats.failed %> 笔失败或超时</small></div>
  </article>
</section>

<% if (isAdmin && config.adminPasswordIsDefault) { %>
<div class="alert alert-warning"><strong>安全提醒：</strong>当前仍在使用默认管理员密码。部署到可访问网络前，请修改 <code>ADMIN_PASSWORD</code> 与 <code>APP_SECRET</code>。</div>
<% } %>

<section class="panel">
  <div class="panel-head">
    <div><p class="eyebrow">RECENT ACTIVITY</p><h2>最近订单</h2></div>
    <a class="button button-ghost button-small" href="/admin/orders">查看全部</a>
  </div>
  <% if (!recentOrders.length) { %>
    <div class="empty-state"><strong>还没有订单</strong><p>创建虚拟卡后，通过 <code>/submit.php</code> 或 <code>/api.php</code> 发起测试支付。</p></div>
  <% } else if (!isAdmin) { %>
  <div class="table-wrap">
    <table>
      <thead><tr><th>网关流水</th><th>商户订单号</th><th>金额</th><th>状态</th><th>创建时间</th><th></th></tr></thead>
      <tbody>
      <% recentOrders.forEach((order) => { %>
        <tr>
          <td><code><%= order.tradeNo %></code></td>
          <td><%= order.outTradeNo %></td>
          <td><strong><%= order.currency %> <%= formatMinor(order.moneyMinor) %></strong></td>
          <td><span class="pill pill-<%= order.status.toLowerCase() %>"><%= statusLabel(order.status) %></span></td>
          <td><%= formatDateTime(order.createdAt) %></td>
          <td class="align-right"><a class="text-link" href="/admin/orders/<%= order.id %>">详情</a></td>
        </tr>
      <% }) %>
      </tbody>
    </table>
  </div>
  <% } %>
</section>

<section class="quick-grid">
  <a class="quick-card" href="/admin/cards/new"><span>+</span><div><strong>创建虚拟卡</strong><small>生成卡号、余额和 3DS 密码</small></div></a>
  <% if (isSuperAdmin) { %>
    <a class="quick-card" href="/admin/bins"><span>#</span><div><strong>管理卡 BIN</strong><small>配置品牌、前缀和卡号长度</small></div></a>
  <% } %>
  <% if (isAdmin) { %>
    <a class="quick-card" href="/admin/users"><span>@</span><div><strong>用户管理</strong><small><%= isSuperAdmin ? '创建管理员或普通用户账号，并调整角色' : '创建普通用户并处理常规风控' %></small></div></a>
  <% } %>
  <% if (isSuperAdmin) { %>
    <a class="quick-card" href="/admin/merchants"><span>↗</span><div><strong>商户密钥</strong><small>查看商户 PID 与 MD5 密钥</small></div></a>
  <% } else { %>
    <a class="quick-card" href="/admin/orders"><span>↗</span><div><strong>我的订单</strong><small>查看已绑定卡片的支付记录</small></div></a>
    <a class="quick-card" href="/"><span>?</span><div><strong>支付说明</strong><small>查看 API 与支付流程文档</small></div></a>
  <% } %>
</section>
<%- include('../partials/admin-end') %>
