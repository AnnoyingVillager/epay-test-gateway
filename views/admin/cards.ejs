<%- include('../partials/head', { bodyClass: 'admin-page' }) %>
<%- include('../partials/admin-start') %>
<section class="panel">
  <div class="toolbar">
    <form method="get" action="/admin/cards" class="filter-form">
      <label class="field inline-field"><span>状态</span><select name="status"><option value="">全部</option><option value="active" <%= status === 'active' ? 'selected' : '' %>>可支付</option><option value="declined" <%= status === 'declined' ? 'selected' : '' %>>模拟拒付</option><option value="frozen" <%= status === 'frozen' ? 'selected' : '' %>>已冻结</option></select></label>
      <label class="field inline-field"><span>搜索</span><input name="q" value="<%= search %>" placeholder="卡 ID 或尾号"></label>
      <button class="button button-ghost button-small" type="submit">筛选</button>
    </form>
    <a class="button button-primary" href="/admin/cards/new">+ 创建虚拟卡</a>
  </div>
  <% if (!cards.length) { %>
    <div class="empty-state"><strong>没有找到虚拟卡</strong><p>创建 BIN 后即可生成测试卡。</p><a class="button button-primary button-small" href="/admin/cards/new">创建虚拟卡</a></div>
  <% } else { %>
  <div class="table-wrap">
    <table>
      <thead><tr><th>卡片</th><th>BIN</th><th>余额</th><th>状态</th><th>有效期</th><th>创建时间</th><th></th></tr></thead>
      <tbody>
      <% cards.forEach((card) => { %>
        <tr>
          <td><div class="table-primary"><span class="mini-card"><%= card.brand.slice(0, 1) %></span><span><strong><%= card.id %></strong><small>•••• <%= card.last4 %></small></span></div></td>
          <td><%= card.binName %><br><small><code><%= card.binPrefix %></code></small></td>
          <td><strong><%= card.currency %> <%= formatMinor(card.balanceMinor) %></strong></td>
          <td><span class="pill <%= card.status === 'active' ? 'pill-success' : 'pill-danger' %>"><%= statusLabel(card.status) %></span></td>
          <td><%= String(card.expiresMonth).padStart(2, '0') %>/<%= card.expiresYear %></td>
          <td><%= formatDateTime(card.createdAt) %></td>
          <td class="align-right"><a class="button button-ghost button-small" href="/admin/cards/<%= card.id %>">管理</a></td>
        </tr>
      <% }) %>
      </tbody>
    </table>
  </div>
  <% } %>
</section>
<%- include('../partials/admin-end') %>
