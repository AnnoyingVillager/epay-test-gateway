<%- include('../partials/head', { bodyClass: 'admin-page' }) %>
<%- include('../partials/admin-start') %>
<div class="detail-grid">
  <section class="panel">
    <div class="panel-head"><div><p class="eyebrow">USER DIRECTORY</p><h2>用户列表</h2></div><span class="count-badge"><%= users.length %></span></div>
    <form method="get" action="/admin/users" class="filter-form">
      <label class="field inline-field"><span>搜索</span><input name="q" value="<%= q %>" placeholder="用户名或 UID"></label>
      <button class="button button-ghost button-small" type="submit">搜索</button>
    </form>
    <form id="batch-users" method="post" action="/admin/users/batch" data-confirm="确认对选中的用户执行批量操作？">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    </form>
    <div class="table-wrap"><table>
      <thead><tr><th><input type="checkbox" data-select-all aria-label="全选用户"></th><th>UID</th><th>用户名</th><th>分组</th><th>账户余额</th><th>邀请</th><th>风控</th><th>状态</th><th></th></tr></thead>
      <tbody>
      <% users.forEach((user) => { %>
        <% const invite = user.invitePermission; %>
        <tr>
          <td><input form="batch-users" type="checkbox" name="user_ids" value="<%= user.id %>"></td>
          <td><code><%= user.uid %></code></td>
          <td><strong><%= user.username %></strong><br><small><%= user.role === 'admin' ? '管理员' : '普通用户' %></small></td>
          <td><%= user.groupName || 'Default' %></td>
          <td><%= formatMinor(user.accountBalanceMinor) %></td>
          <td class="invite-permission-cell">
            <div class="invite-permission-status">
              <strong><%= user.invitedCount %> / <%= user.inviteLimit %></strong>
              <span class="pill <%= invite.enabled ? 'pill-success' : 'pill-muted' %>"><%= invite.enabled ? '可邀请' : '无权限' %></span>
            </div>
            <small><%= user.invitePermissionMode === 'custom' ? '单独开关' : '继承全局' %> · 全局<%= globalInvitesEnabled ? '开启' : '关闭' %></small>
            <form method="post" action="/admin/users/<%= user.uid %>/invite-permission" class="invite-permission-form">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <select name="invite_permission_mode" aria-label="<%= user.username %> 的邀请权限模式">
                <option value="inherit" <%= user.invitePermissionMode !== 'custom' ? 'selected' : '' %>>继承全局</option>
                <option value="custom" <%= user.invitePermissionMode === 'custom' ? 'selected' : '' %>>单独开关</option>
              </select>
              <input type="hidden" name="can_invite" value="0">
              <label class="checkbox-field compact-checkbox"><input type="checkbox" name="can_invite" value="1" <%= user.canInvite ? 'checked' : '' %>><span>开启</span></label>
              <button class="button button-ghost button-small" type="submit">保存</button>
            </form>
          </td>
          <td><%= user.accountRisk %> / <%= user.cardRisk %></td>
          <td><span class="pill <%= user.isActive ? 'pill-success' : 'pill-danger' %>"><%= user.isActive ? '启用' : '禁用' %></span></td>
          <td class="align-right"><a class="button button-ghost button-small" href="/admin/users/<%= user.uid %>">详情</a></td>
        </tr>
      <% }) %>
      </tbody>
    </table></div>
    <div class="form-grid compact-grid batch-panel">
      <label class="field"><span>批量分组</span><select form="batch-users" name="group_id"><% groups.forEach((group) => { %><option value="<%= group.id %>"><%= group.name %></option><% }) %></select></label>
      <label class="field"><span>批量金额</span><input form="batch-users" type="number" name="amount" min="0.01" step="0.01" placeholder="0.00"></label>
      <label class="field"><span>禁用理由</span><input form="batch-users" name="disabled_reason" value="风险控制" maxlength="200"></label>
      <div class="form-actions button-row">
        <button form="batch-users" class="button button-primary button-small" name="action" value="group" type="submit">调整分组</button>
        <button form="batch-users" class="button button-ghost button-small" name="action" value="add_balance" type="submit">增加余额</button>
        <button form="batch-users" class="button button-ghost button-small" name="action" value="subtract_balance" type="submit">减少余额</button>
        <button form="batch-users" class="button button-danger button-small" name="action" value="disable" type="submit">批量禁用</button>
      </div>
    </div>
  </section>
  <aside class="panel sticky-panel">
    <div class="panel-head"><div><p class="eyebrow">NEW USER</p><h2>创建用户</h2></div></div>
    <form method="post" action="/admin/users" class="stack-form">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <label class="field"><span>用户名</span><input name="username" required autocomplete="off"></label>
      <label class="field"><span>密码</span><input type="password" name="password" minlength="8" required autocomplete="new-password"></label>
      <label class="field"><span>角色</span><select name="role"><option value="user">普通用户</option><option value="admin">管理员（非根管理员）</option></select></label>
      <label class="field"><span>用户分组</span><select name="group_id"><% groups.forEach((group) => { %><option value="<%= group.id %>" <%= group.name === 'Default' ? 'selected' : '' %>><%= group.name %></option><% }) %></select></label>
      <label class="field"><span>邀请权限模式</span><select name="invite_permission_mode"><option value="inherit">继承全局策略</option><option value="custom">使用单独开关</option></select></label>
      <label class="field checkbox-field"><input type="hidden" name="can_invite" value="0"><input type="checkbox" name="can_invite" value="1" checked><span>开启单独邀请开关</span></label>
      <button class="button button-primary button-block" type="submit">创建用户</button>
      <p class="form-hint">根管理员始终为 UID 0；其他用户自动分配独立 UID。单独开关模式不受全局邀请策略影响。</p>
    </form>
  </aside>
</div>

<%- include('../partials/admin-end') %>