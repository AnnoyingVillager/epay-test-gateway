<%- include('../partials/head', { bodyClass: 'admin-page' }) %>
<%- include('../partials/admin-start') %>
<div class="detail-grid">
  <div class="panel-column">
    <section class="panel">
      <div class="panel-head"><div><p class="eyebrow">ACCOUNT BALANCE</p><h2>我的账户</h2></div></div>
      <div class="amount">CNY <%= formatMinor(user.accountBalanceMinor) %></div>
      <dl class="meta-list">
        <div><dt>UID</dt><dd><code><%= user.uid %></code></dd></div>
        <div><dt>分组</dt><dd><%= user.groupName || 'Default' %></dd></div>
        <div><dt>生效消费限额</dt><dd><%= effectiveLimitMinor === null ? '不限制' : 'CNY ' + formatMinor(effectiveLimitMinor) %></dd></div>
        <div><dt>累计已消费</dt><dd>CNY <%= formatMinor(spentMinor) %></dd></div>
        <div><dt>卡面额度</dt><dd><%= user.cardBalanceLimitMinor === null ? '不限制' : `CNY ${formatMinor(user.cardBalanceLimitMinor)}` %></dd></div>
      </dl>
    </section>
    <section class="panel">
      <div class="panel-head"><div><p class="eyebrow">ACCOUNT SECURITY</p><h2>修改登录密码</h2></div></div>
      <form method="post" action="/admin/account/password" class="stack-form">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <label class="field"><span>原密码</span><input type="password" name="old_password" autocomplete="current-password" required></label>
        <label class="field"><span>新密码</span><input type="password" name="new_password" autocomplete="new-password" maxlength="128" required></label>
        <label class="field"><span>确认新密码</span><input type="password" name="confirm_password" autocomplete="new-password" maxlength="128" required></label>
        <p class="form-hint">新密码需符合管理员配置的密码规则。修改成功后，当前账号的所有旧登录会话都会失效。</p>
        <div class="form-actions"><button class="button button-primary" type="submit">更新密码</button></div>
      </form>
    </section>
  </div>
  <section class="panel">
    <div class="panel-head"><div><p class="eyebrow">CARD TRANSFER</p><h2>账户与卡片互转</h2></div></div>
    <% if (!cards.length) { %><div class="empty-state compact">暂无可操作的虚拟卡。<a class="text-link" href="/admin/cards/new">创建虚拟卡</a></div><% } else { %>
      <form method="post" action="/admin/account/deposit" class="stack-form" data-money-confirm data-confirm-title="确认充值到虚拟卡" data-confirm-message="系统将从账户余额扣除金额并充值到所选虚拟卡。" data-confirm-action="确认充值" data-confirm-currency="CNY" data-confirm-amount-field="amount" data-confirm-target-field="card_id" data-confirm-target-label="目标卡" data-confirm-note="手续费以服务端计算结果为准，确认后将立即变动账户和卡余额。">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="step-label"><span>1</span> 账户余额充值到虚拟卡</div>
        <label class="field"><span>目标卡</span><select name="card_id"><% cards.forEach((card) => { %><option value="<%= card.id %>"><%= formatCardLabel(card) %> · 当前 <%= formatMinor(card.balanceMinor) %></option><% }) %></select></label>
        <label class="field"><span>充值到卡金额</span><input type="number" name="amount" min="0.01" step="0.01" required></label>
        <p class="form-hint">手续费 <%= settings.card_deposit_fee_bps %> bps，最低手续费 <%= formatMinor(settings.card_min_deposit_fee_minor) %>，最低充值 <%= formatMinor(settings.card_min_deposit_minor) %>。</p>
        <button class="button button-primary" type="submit">充值到卡</button>
      </form>
      <% if (settings.card_withdraw_enabled === '1') { %>
        <hr class="divider">
        <form method="post" action="/admin/account/withdraw" class="stack-form" data-money-confirm data-confirm-title="确认提现到账户" data-confirm-message="系统将从所选虚拟卡扣除金额，并将扣除手续费后的金额转入账户余额。" data-confirm-action="确认提现" data-confirm-currency="CNY" data-confirm-amount-field="amount" data-confirm-target-field="card_id" data-confirm-target-label="来源卡" data-confirm-note="提现手续费以服务端计算结果为准，确认后将立即变动卡余额和账户余额。">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="step-label"><span>2</span> 卡内余额提现到账户</div>
          <label class="field"><span>来源卡</span><select name="card_id"><% cards.forEach((card) => { %><option value="<%= card.id %>"><%= formatCardLabel(card) %> · 当前 <%= formatMinor(card.balanceMinor) %></option><% }) %></select></label>
          <label class="field"><span>从卡扣除金额</span><input type="number" name="amount" min="0.01" step="0.01" required></label>
          <p class="form-hint">手续费 <%= settings.card_withdraw_fee_bps %> bps，最低手续费 <%= formatMinor(settings.card_min_withdraw_fee_minor) %>，最低提现 <%= formatMinor(settings.card_min_withdraw_minor) %>。</p>
          <button class="button button-ghost" type="submit">提现到账户</button>
        </form>
      <% } else { %><div class="alert alert-warning">管理员已关闭卡内余额提现。</div><% } %>
    <% } %>
  </section>
</div>
<section class="panel">
  <div class="panel-head"><div><p class="eyebrow">LEDGER</p><h2>账户流水</h2></div><span class="count-badge"><%= transactions.length %></span></div>
  <% if (!transactions.length) { %><div class="empty-state compact">暂无账户流水。</div><% } else { %><div class="table-wrap"><table><thead><tr><th>时间</th><th>类型</th><th>金额</th><th>余额</th><th>说明</th></tr></thead><tbody><% transactions.forEach((tx) => { %><tr><td><%= formatDateTime(tx.created_at) %></td><td><%= tx.type %></td><td><%= formatMinor(tx.amount_minor) %></td><td><%= formatMinor(tx.balance_after_minor) %></td><td><%= tx.note || '-' %></td></tr><% }) %></tbody></table></div><% } %>
</section>
<%- include('../partials/admin-end') %>
