<%- include('partials/head', { bodyClass: 'checkout-page' }) %>
<main class="checkout-shell">
  <header class="checkout-header">
    <a class="brand" href="/">
      <span class="brand-mark">E</span>
      <span><strong>Epay</strong><small>Secure Test Checkout</small></span>
    </a>
    <span class="test-badge">SELECT PAYMENT</span>
  </header>

  <section class="checkout-card">
    <div class="checkout-summary">
      <p class="eyebrow">支付订单</p>
      <h1><%= order.name %></h1>
      <div class="amount"><small><%= order.currency %></small><%= order.money %></div>
      <dl class="summary-list">
        <div><dt>商户</dt><dd><%= order.merchantName %></dd></div>
        <div><dt>订单号</dt><dd><code><%= order.outTradeNo %></code></dd></div>
        <div><dt>网关流水</dt><dd><code><%= order.tradeNo %></code></dd></div>
        <div><dt>支付方式</dt><dd><%= order.type %></dd></div>
      </dl>
      <div class="countdown-box <%= remainingSeconds <= 0 ? 'expired' : '' %>" data-expires="<%= order.expiresAt %>" data-order-status-url="/pay/<%= encodeURIComponent(order.tradeNo) %>/status" data-order-status="<%= order.status %>">
        <span>订单剩余时间</span>
        <strong data-countdown><%= Math.floor(remainingSeconds / 60) %>:<%= String(remainingSeconds % 60).padStart(2, '0') %></strong>
      </div>
    </div>

    <div class="checkout-payment">
      <div class="alert alert-info">当前登录：<strong><%= currentUser.username %></strong>（UID <%= currentUser.uid %>）。账户余额：<strong><%= order.currency %> <%= formatMinor(accountBalanceMinor) %></strong>。</div>
      <% if (error) { %><div class="alert alert-danger" role="alert"><%= error %></div><% } %>

      <form method="post" action="/pay/<%= encodeURIComponent(order.tradeNo) %>/account" class="stack-form" data-payment-submit data-payment-redirect>
        <div class="step-label"><span>A</span> 使用账户余额支付</div>
        <button class="button button-primary button-block" type="submit" <%= order.canPay && accountBalanceMinor >= order.moneyMinor ? '' : 'disabled' %>>账户余额支付 <%= order.currency %> <%= order.money %></button>
        <p class="secure-note">登录后可直接使用账户余额支付，不再进行 3DS 或卡片验证。</p>
      </form>

      <hr class="divider">
      <% if (userCards.length) { %>
        <form method="post" action="/pay/<%= encodeURIComponent(order.tradeNo) %>/bind" class="stack-form" data-payment-submit>
          <div class="step-label"><span>B</span> 选择我的虚拟卡</div>
          <label class="field"><span>可用卡片</span>
            <select name="card_id" required>
              <% userCards.forEach((card) => { %>
                <option value="<%= card.id %>"><%= card.binName %> (<%= card.cardType === 'credit' ? '信用卡' : '借记卡' %>) <%= card.binPrefix %>***<%= card.last4 %></option>
              <% }) %>
            </select>
          </label>
          <button class="button button-primary button-block" type="submit" <%= order.canPay ? '' : 'disabled' %>>使用选中的卡片支付</button>
          <p class="secure-note">此处只显示当前登录账号名下的虚拟卡。</p>
        </form>
      <% } else { %>
        <div class="empty-state compact">当前账号还没有虚拟卡。<a class="text-link" href="/admin/cards/new">先创建一张虚拟卡</a></div>
      <% } %>
      <p class="form-hint">登录身份不对时，可以<a class="text-link" href="/admin/logout">退出当前账号</a>后使用其他账号重新登录。</p>
    </div>
  </section>

  <p class="checkout-footer">Epay Test Gateway · 仅用于测试，不处理真实银行卡信息</p>
</main>
<script src="/js/payment.js?v=<%= assetVersion %>" defer></script>
</body>
</html>
