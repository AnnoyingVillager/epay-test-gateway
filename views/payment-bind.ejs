<%- include('partials/head', { bodyClass: 'checkout-page' }) %>
<main class="checkout-shell">
  <header class="checkout-header">
    <a class="brand" href="/">
      <span class="brand-mark">E</span>
      <span><strong>Epay</strong><small>Secure Test Checkout</small></span>
    </a>
    <span class="test-badge">BIND CARD</span>
  </header>

  <section class="checkout-card">
    <div class="checkout-summary">
      <p class="eyebrow">支付订单</p>
      <h1><%= order.name %></h1>
      <div class="amount"><small><%= order.currency %></small><%= order.money %></div>
      <dl class="summary-list">
        <div><dt>商户</dt><dd><%= order.merchantName %></dd></div>
        <div><dt>订单号</dt><dd><code><%= order.outTradeNo %></code></dd></div>
        <div><dt>网关流水</dt><dd><code><%= order.tradeNo %></code></dd></div>
        <div><dt>支付方式</dt><dd><%= order.type %></dd></div>
      </dl>
      <div class="countdown-box <%= remainingSeconds <= 0 ? 'expired' : '' %>" data-expires="<%= order.expiresAt %>">
        <span>订单剩余时间</span>
        <strong data-countdown><%= Math.floor(remainingSeconds / 60) %>:<%= String(remainingSeconds % 60).padStart(2, '0') %></strong>
      </div>
    </div>

    <div class="checkout-payment">
      <div class="step-label"><span>1</span> 绑定虚拟银行卡</div>
      <% if (error) { %><div class="alert alert-danger" role="alert"><%= error %></div><% } %>

      <% if (!currentUser) { %>
        <div class="alert alert-info">该订单尚未绑定虚拟卡。你可以登录后选择自己的卡片，也可以直接输入管理员提供的卡片 ID。</div>
        <form method="post" action="/pay/<%= encodeURIComponent(order.tradeNo) %>/login" class="stack-form">
          <div class="step-label"><span>A</span> 登录后选卡</div>
          <label class="field"><span>用户名</span><input name="username" autocomplete="username" required></label>
          <label class="field"><span>密码</span><input type="password" name="password" autocomplete="current-password" required></label>
          <button class="button button-primary button-block" type="submit">登录并选择卡片</button>
        </form>
      <% } else { %>
        <div class="alert alert-info">当前登录：<strong><%= currentUser.username %></strong>（<%= currentUser.role === 'admin' ? '管理员' : '普通用户' %>）。普通用户只能选择自己名下的卡片。</div>
        <% if (userCards.length) { %>
          <form method="post" action="/pay/<%= encodeURIComponent(order.tradeNo) %>/bind" class="stack-form">
            <div class="step-label"><span>A</span> 选择我的虚拟卡</div>
            <label class="field"><span>可用卡片</span>
              <select name="card_id" required>
                <% userCards.forEach((card) => { %>
                  <option value="<%= card.id %>"><%= card.id %> · •••• <%= card.last4 %> · <%= card.currency %> <%= formatMinor(card.balanceMinor) %> · <%= statusLabel(card.status) %></option>
                <% }) %>
              </select>
            </label>
            <button class="button button-primary button-block" type="submit" <%= order.canPay ? '' : 'disabled' %>>使用选中的卡片支付</button>
          </form>
        <% } else { %>
          <div class="empty-state compact">当前账号还没有虚拟卡。<a class="text-link" href="/admin/cards/new">先创建一张虚拟卡</a></div>
        <% } %>
        <p class="form-hint">登录身份不对时，可以<a class="text-link" href="/admin/logout">退出当前账号</a>后使用其他账号重新登录。</p>
      <% } %>

      <hr class="divider">
      <form method="post" action="/pay/<%= encodeURIComponent(order.tradeNo) %>/bind" class="stack-form">
        <div class="step-label"><span>B</span> 直接绑定卡片支付</div>
        <label class="field">
          <span>虚拟卡 ID</span>
          <input name="card_id" placeholder="例如 CARD-1234ABCD" required autocomplete="off">
        </label>
        <button class="button <%= currentUser ? 'button-ghost' : 'button-primary' %> button-block" type="submit" <%= order.canPay ? '' : 'disabled' %>>绑定此卡并继续</button>
        <p class="secure-note">绑定后订单将只允许使用该虚拟卡，不能切换到其他卡片。不会产生真实资金交易。</p>
      </form>
    </div>
  </section>

  <p class="checkout-footer">Epay Test Gateway · 仅用于测试，不处理真实银行卡信息</p>
</main>
<script src="/js/payment.js" defer></script>
</body>
</html>
