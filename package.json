{
  "name": "epay-test-gateway",
  "version": "2.2.5",
  "private": true,
  "description": "A self-hosted Epay-compatible test gateway with user roles, virtual cards and an admin panel.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "test:merchant": "node scripts/merchant-smoke.js",
    "rotate:app-secret": "node scripts/rotate-app-secret.js"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "ejs": "^3.1.10",
    "express": "^5.3.0",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "nodemailer": "^10.3.1"
  },
  "devDependencies": {
    "supertest": "^7.1.4"
  }
}
