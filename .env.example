# Copy this file to .env and replace every secret before exposing the gateway.

# Public URL of the gateway. Leave empty to infer from each request.
# Example: https://epay-test.example.com
BASE_URL=

# Web port on the Docker host.
APP_PORT=3001

# Initial administrator credentials (used when no active admin exists).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-now
ADMIN_SESSION_HOURS=12

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=replace-with-a-long-random-secret

# Default merchant created on first boot.
DEFAULT_MERCHANT_PID=1001
DEFAULT_MERCHANT_NAME=Demo Merchant
DEFAULT_MERCHANT_KEY=replace-with-a-random-merchant-key

# Payment defaults.
ORDER_TIMEOUT_SECONDS=900
NOTIFY_RETRY_COUNT=3
NOTIFY_TIMEOUT_MS=8000

# Reverse proxy / HTTPS settings.
TRUST_PROXY=false
COOKIE_SECURE=false
